<launch>
  <arg name="city" default="Toronto" />

  <!-- These are removed because we are using /tf messages. -->
  <!-- <param name="robot_description"
    textfile="$(find cartographer_ros)/urdf/jackal.urdf.xacro" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
    type="robot_state_publisher" /> -->
  <!-- include the laptop bridge launch file to run the decompression   -->
  <!-- start src/slam_jackal/scripts/ouster_range_to_pc.py -->
  <!-- <node pkg="slam_jackal" type="ouster_range_to_pc.py" name="ouster_range_to_pc" output="screen"/> -->
  <!-- start from patchworkpp launch/demo.launch -->
  <!-- <include file="$(find patchworkpp)/launch/demo.launch" /> -->

  <group if="$(eval arg('city') == 'Munich')">
    <!-- <node name="cartographer_node" pkg="cartographer_ros" type="cartographer_node" args=" -configuration_directory $(find cartographer_ros)/configuration_files -configuration_basename jackal2_2d_liveslam_munich.lua" output="screen" launch-prefix="nice -n -10"> -->
    <node name="cartographer_node" pkg="cartographer_ros"
        type="cartographer_node" args="
            -configuration_directory $(find cartographer_ros)/configuration_files
            -configuration_basename jackal2_2d_liveslam_munich.lua"
        output="screen" launch-prefix="nice -n -10">
    <!-- <remap from="imu" to="ouster_imu_debiased" /> -->
    <remap from="imu" to="ouster/imu" />
    <remap from="points2" to="filtered_point_cloud2" />
    <remap from="odom" to="/jackal_velocity_controller/odom" />
    </node>
  </group>

  <group unless="$(eval arg('city') == 'Munich')">
    <node name="cartographer_node" pkg="cartographer_ros"
        type="cartographer_node" args="
            -configuration_directory $(find cartographer_ros)/configuration_files
            -configuration_basename jackal2_2d_liveslam_toronto.lua"
        output="screen" launch-prefix="nice -n -10">
      <!-- <remap from="imu" to="ouster/imu" /> -->
      <remap from="imu" to="ouster_imu_debiased" />
      <remap from="points2" to="filtered_point_cloud2" />
      <!-- <remap from="points2_1" to="filtered_point_cloud2" /> -->
      <!-- <remap from="points2_2" to="sam_point_cloud_localization" /> -->
      <remap from="odom" to="/jackal_velocity_controller/odom"/>
    </node>
  </group>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.2" launch-prefix="nice -n -5"/>
</launch>
